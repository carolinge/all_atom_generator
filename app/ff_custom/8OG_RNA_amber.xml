  <!-- ── Supplemental force field parameters for 8OG ─────────────────────
       All parameters below are for atom type pairs involving RNA-CB - RNA-NA
       that do NOT exist in RNA.OL3.xml (because standard RNA has NB at N7,
       not NA). All other 8OG bonds/angles/torsions reuse existing OL3 terms.
  ─────────────────────────────────────────────────────────────────────────── -->

  <HarmonicBondForce>
    <!--
      C5(RNA-CB) - N7(RNA-NA): new bond type.
      Reference: RNA-CB - RNA-NB in OL3.xml: k=346435, r0=0.1391 nm.
      NA has slightly shorter equilibrium length than NB (sp2 N-H vs aromatic N).
      Value chosen consistent with AMBER99 CB-NA analogy.
    -->
    <Bond k="346435.2" length="0.1390" type1="RNA-CB" type2="RNA-NA"/>
  </HarmonicBondForce>

  <HarmonicAngleForce>
    <!--
      C5(CB) - N7(NA) - C8(C): angle at N7 in the 5-membered imidazole ring.
      Reference: RNA-CB - RNA-NB - RNA-CP in OL3.xml: k=585.76, 1.8117 rad (103.8°).
      In 8OG the ring geometry is similar (N7 still in imidazole ring).
    -->
    <Angle angle="1.8117" k="585.76" type1="RNA-CB" type2="RNA-NA" type3="RNA-C"/>

    <!--
      C5(CB) - N7(NA) - H7(H): exocyclic angle at N7.
      Reference: analogous to RNA-C - RNA-NA - RNA-H in OL3 (k=418.40, 2.0385 rad).
      For the 5-membered ring context the three angles at N7 must sum to ~360°:
        C8-N7-C5 ≈ 103.8°, C8-N7-H7 ≈ 116.8° (from C-NA-H in OL3),
        so C5-N7-H7 ≈ 360 - 103.8 - 116.8 = 139.4° = 2.433 rad.
      This is geometrically correct for a planar sp2 N where H points away
      from the ring. The planarity is additionally enforced by the improper
      torsion RNA-NA - ... - RNA-H already in OL3.xml (line: Improper RNA-NA H).
    -->
    <Angle angle="2.433" k="418.40" type1="RNA-CB" type2="RNA-NA" type3="RNA-H"/>
  </HarmonicAngleForce>

  <PeriodicTorsionForce ordering="amber">
    <!--
      X - C5(CB) - N7(NA) - X: torsion around the C5-N7 bond.
      Reference: X - RNA-CB - RNA-NB - X in OL3.xml: k=10.6692, per=2, phase=pi.
      Same value used since the electronic character is similar.
    -->
    <Proper k1="10.6692" periodicity1="2" phase1="3.141592653589793"
            type1="" type2="RNA-CB" type3="RNA-NA" type4=""/>

    <!--
      Improper for N9: maintains planarity of the glycosidic nitrogen.
      In G (OL3.xml): <Improper type1="RNA-N*" type2="RNA-CB" type3="RNA-CP" type4="RNA-CT">
      In 8OG: C8 changes from RNA-CP to RNA-C, so we need the updated term.
    -->
    <Improper k1="4.184" periodicity1="2" phase1="3.141592653589793"
              type1="RNA-N*" type2="RNA-CB" type3="RNA-C" type4="RNA-CT"/>
  </PeriodicTorsionForce>

</ForceField>

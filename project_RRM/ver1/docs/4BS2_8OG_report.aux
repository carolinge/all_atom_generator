\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-residue contact frequencies for protein partners of G3. Residues 76--79 (RNP1 motif) lose contact in the 8OG variant, with partial compensation at residues 15 and 18 (RNP2 vicinity). The 22\% reduction at A79, the principal contact partner, is the single most direct piece of evidence for weakened interaction at the modification site.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:partners}{{3}{7}{Per-residue contact frequencies for protein partners of G3. Residues 76--79 (RNP1 motif) lose contact in the 8OG variant, with partial compensation at residues 15 and 18 (RNP2 vicinity). The 22\% reduction at A79, the principal contact partner, is the single most direct piece of evidence for weakened interaction at the modification site}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-replica means over 100\,ns. The 8OG simulation shows \emph  {higher} contact counts and \emph  {higher} G3 polar contact counts than WT -- a complete reversal of the direction predicted from the preliminary 10\,ns comparison (Table~\ref {tab:summary}). The strength of this conclusion is currently limited by 8OG having only a single completed replica; the second 8OG replica is at 57\,ns and consistent in trend (312 contacts, 6.0 G3 polar).}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:multi}{{4}{7}{Per-replica means over 100\,ns. The 8OG simulation shows \emph {higher} contact counts and \emph {higher} G3 polar contact counts than WT -- a complete reversal of the direction predicted from the preliminary 10\,ns comparison (Table~\ref {tab:summary}). The strength of this conclusion is currently limited by 8OG having only a single completed replica; the second 8OG replica is at 57\,ns and consistent in trend (312 contacts, 6.0 G3 polar)}{table.caption.10}{}}

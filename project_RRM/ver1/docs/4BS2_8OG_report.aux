\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Multi-replica time series of the four primary CVs over 100\,ns. Solid lines are means across replicas (WT $n=3$, 8OG $n=1$); shaded bands are the standard error of the mean across replicas. The \textbf  {conclusions invert relative to the 10\,ns single-replica comparison} (Section~\ref {sec:short}): WT contacts and G3 polar contacts are now \emph  {lower} than 8OG, and WT shows large excursions that are absent in 8OG.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:multi-ts}{{4}{8}{Multi-replica time series of the four primary CVs over 100\,ns. Solid lines are means across replicas (WT $n=3$, 8OG $n=1$); shaded bands are the standard error of the mean across replicas. The \textbf {conclusions invert relative to the 10\,ns single-replica comparison} (Section~\ref {sec:short}): WT contacts and G3 polar contacts are now \emph {lower} than 8OG, and WT shows large excursions that are absent in 8OG}{figure.caption.9}{}}
